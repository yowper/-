<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="上滑时长（毫秒，越小越“甩”）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgDur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="300" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="命令冷却（毫秒）：同一句话两次触发的最小间隔"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgGap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="2000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="蓝牙耳机音量下调识别窗口（毫秒，默认 1000，最短 200）：短剧模式=恰好两下调→上拉+还原音量；非短剧=一下调→下一页+音量上键补一次"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgVolMs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="1000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="键盘麦克风按钮位置 X（百分比）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgMicX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="22" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="键盘麦克风按钮位置 Y（百分比）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgMicY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="66" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="点开 Mic 后最多等豆包多久（秒，3 ~ 20）：框里一出现短文本（≤6 字）会立刻收尾，不会真的等满"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="点 Mic 前延时（毫秒，0 ~ 3000）：编辑框激活、豆包键盘弹出后再等这么久点 Mic，越小越快"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dlgMicDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="200" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="点击位置已固定在程序里，不需要设置：\n· 暂停 / 恢复：(50%, 20%)\n· 下页：(85%, 85%)\n· 上页：(15%, 85%)"
            android:textColor="#666666"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
